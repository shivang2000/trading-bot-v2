# ═══════════════════════════════════════════════════════════════════════
# Trading Bot V2 — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git — it contains secrets!
# ═══════════════════════════════════════════════════════════════════════

# ── MT5 Connection ───────────────────────────────────────────────────
# Auto-set by docker-compose.ec2.yml — only change if running standalone
# MT5_HOST=metatrader5
# MT5_PORT=8001

# ── Telegram User Account (for reading signal channels) ─────────────
# Required for Telegram signal ingestion
# Get API credentials from: https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+1234567890

# ── Claude AI (for signal parsing + Claude pre-trade filter) ────────
# Required. Get from: https://console.anthropic.com
# Used by: Telegram signal parser + ClaudeSignalFilter
# Cost: ~$0.01/day at 100 trades (Haiku model)
ANTHROPIC_API_KEY=

# ── Notifications (optional but recommended) ────────────────────────
# Slack webhook for trade alerts and daily summaries
SLACK_WEBHOOK_URL=

# Telegram bot for mobile notifications (separate from listener above)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Discord (optional, recommended for funded accounts) ─────────────
# Two modes supported:
#
# 1. WEBHOOK (simplest, one-way):
#    Create at: Discord server → #trading-bot channel →
#    Channel settings → Integrations → Webhooks → New Webhook → Copy URL
#    Set DISCORD_WEBHOOK_URL below.
#
# 2. BOT TOKEN (posts as hermesagent#5141, same identity as Hermes gateway):
#    Set DISCORD_BOT_TOKEN + DISCORD_ALERT_CHANNEL_ID.
#    Channel ID for #trading-bot: 1525476646176690297
#    (found via: hermes send --list discord)
#
# If both are set, webhook mode wins.
# If neither is set, DiscordNotifier is auto-disabled and the bot runs fine
# using Slack/Telegram instead. The post-mortem's lesson #1 is
# "no silent failure on a funded account" — set at least ONE of these.
# DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_ALERT_CHANNEL_ID=1525476646176690297
# Optional: ping string prepended on critical alerts (e.g. "<@&ROLE_ID>" or "@here")
# DISCORD_CRITICAL_PING=

# ── Config Overlay ───────────────────────────────────────────────────
# Loads config/<name>.yaml on top of base.yaml
# Set to "fundingpips" for prop firm trading
CONFIG_OVERLAY=fundingpips
