# Slim image for the copy-trader process.
# No pandas/pandas-ta/anthropic dependencies — pure mirror needs only:
#   rpyc (MT5 RPC), aiohttp (Slack), pydantic (config), pyyaml.

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
    && rm -rf /var/lib/apt/lists/*

# Install only the deps the copy-trader actually needs (sub-set of pyproject)
RUN pip install --no-cache-dir \
        "rpyc>=5.0,<6.0" \
        "aiohttp>=3.9" \
        "pydantic>=2.5" \
        "pyyaml>=6.0" \
        "structlog>=24.1" \
        "aiosqlite>=0.19" \
        "python-dotenv>=1.0"

# Copy only the modules the copy-trader uses (keeps image small + makes
# the isolation rule explicit at the filesystem layer)
COPY src/__init__.py src/__init__.py
COPY src/copy_trader/ src/copy_trader/
COPY src/config/__init__.py src/config/__init__.py
COPY src/config/copy_trader_schema.py src/config/copy_trader_schema.py
COPY src/core/ src/core/
COPY src/mt5/ src/mt5/
COPY config/copy_trader.yaml config/copy_trader.yaml

RUN useradd --create-home --shell /bin/bash botuser \
    && mkdir -p /app/data /app/logs \
    && chown -R botuser:botuser /app
USER botuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

CMD ["python", "-m", "src.copy_trader.main"]
